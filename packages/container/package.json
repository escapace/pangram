  },
  "bugs": "https://github.com/escapace/pangram/issues",
  "dependencies": {
    "@escapace/browserslist": "^0.2.1",
    "@escapace/cli": "^0.3.1",
    "@pangram/font-loader": "workspace:*",
    "@pangram/unicode-tools": "workspace:*",
    "@sindresorhus/fnv1a": "^3.1.0",
    "bignumber.js": "^9.3.1",
    "browserslist": "^4.28.1",
    "cosmiconfig": "^9.0.1",
    "css-tree": "^3.2.1",
    "esbuild": "^0.27.3",
    "execa": "^9.6.1",
    "find-up": "^7.0.0",
    "hashids": "^2.3.0",
    "lightningcss": "^1.32.0",
    "lodash-es": "^4.17.23",
    "mlly": "^1.8.1",
    "p-memoize": "^7.1.1",
    "pangram": "workspace:*",
    "safe-stable-stringify": "^2.5.0",
    "url-join": "^5.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ls-lint/ls-lint": "2.3.1",
    "@types/css-tree": "2.3.11",
    "@types/lodash-es": "4.17.12",
    "@types/node": "22.15.21",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.39.4",
    "eslint-config-escapace": "5.9.2",
    "esroll": "0.4.5",
    "prettier": "3.8.1",
    "prettier-config-escapace": "1.2.1",
    "syncpack": "13.0.4",
    "tsx": "4.21.0",
    "type-fest": "4.41.0",
    "typescript": "5.8.3",
    "utility-types": "3.11.0",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.15.0",
    "pnpm": ">=10.10.0"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/node/index.js"
    }
  },
  "files": [
    "Dockerfile",
    "pyproject.toml",
    "scripts",
    "src",
    "test",
    "tsconfig*",
    "uv.lock",
    "vitest*"
  ],
  "homepage": "https://github.com/escapace/pangram/tree/trunk/packages/container#readme",
  "license": "MPL-2.0",
  "private": true,
  "repository": "escapace/pangram",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "container:build": "pnpm run pack && docker build -t pangram:latest -f package/packages/container/Dockerfile --target production --build-arg NODE_VERSION=22.15.0 --build-arg PNPM_VERSION=10.10.0 - < lib/context.tgz",
    "container:test": "pnpm run pack && docker build -t pangram:test -f package/packages/container/Dockerfile --target test --build-arg NODE_VERSION=22.15.0 --build-arg PNPM_VERSION=10.10.0 - < lib/context.tgz",
    "format": "syncpack format --source package.json && eslint --no-warn-ignored --fix && prettier -uw .",
    "lint": "ls-lint --config .ls-lint.yaml && eslint",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "pack": "pnpm-pack workspace --no-build --pack-destination lib/context.tgz",
    "test": "vitest --no-watch --coverage",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./lib/types/index.d.ts"
}
